  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "testdev": "VITE_AWS_LOGGER_LEVEL=ERROR cypress run --env VITE_ENV=development",
    "teststag": "VITE_AWS_LOGGER_LEVEL=ERROR cypress run --env VITE_ENV=staging",
    "cy:opendev": "cypress open --env VITE_ENV=development",
    "cy:openstag": "cypress open --env VITE_ENV=staging",
    "cy:ci": "VITE_AWS_LOGGER_LEVEL=ERROR CI=true cypress run",
    "lint:fix": "eslint \"src/**\" --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss,js,jsx,ts,tsx}\"",
    "lint:time": "TIMING=1 eslint \"src/**\"",
    "pretty": "prettier --write \"src/**\"",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-links": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/aws4": "^1.11.6",
