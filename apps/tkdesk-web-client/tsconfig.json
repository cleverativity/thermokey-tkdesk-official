{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "API": ["./src/API.ts"],
      "Api": ["./src/Api"],
      "Api/*": ["./src/Api/*"],
      "Components": ["./src/Components"],
      "Components/*": ["./src/Components/*"],
      "Configs": ["./src/Configs"],
      "Configs/*": ["./src/Configs/*"],
      "cypress.decorators": ["./src/cypress.decorators"],
      "cypress.decorators/*": ["./src/cypress.decorators/*"],
      "Generic": ["./src/Generic"],
      "Generic/*": ["./src/Generic/*"],
      "graphql": ["./src/graphql"],
      "graphql/*": ["./src/graphql/*"],
      "Images": ["./src/Images"],
      "Images/*": ["./src/Images/*"],
      "Localization": ["./src/Localization"],
      "Localization/*": ["./src/Localization/*"],
      "Model": ["./src/Model"],
      "Model/*": ["./src/Model/*"],
      "Modules": ["./src/Modules"],
      "Modules/*": ["./src/Modules/*"],
      "redux": ["./src/redux"],
      "redux/*": ["./src/redux/*"],
      "store": ["./src/store"],
      "store/*": ["./src/store/*"],
      "styles": ["./src/styles"],
      "styles/*": ["./src/styles/*"],
      "Utils": ["./src/Utils"],
      "Utils/*": ["./src/Utils/*"],
      "amplifyconfiguration.json": ["./src/amplifyconfiguration.json"],
      "aws-exports.js": ["./src/aws-exports.js"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["vite.config.ts", "src"],
  "exclude": ["node_modules", "cypress", "build", "storybook-static"]
}
