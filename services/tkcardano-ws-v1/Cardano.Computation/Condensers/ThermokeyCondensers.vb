                                            thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                            'TkMicro32/NH3(Ammonia) - EC-Ziehl/Abbeg: 400V~50Hz-  C. Gnesutta,  December 7th, 2020.-Ok
                                            thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


