        'EC Fans - EBM-Papst
        If (foundFanType = "B1") Then

            Select Case True

                Case (found_EC_Index = 0)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve1_DpAir_EBMPapst(found_EC_IdCM - 1)

