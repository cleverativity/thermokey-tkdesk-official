                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                    'Caso ventilatore EC
                Else

                    'NON CI SONO ACCESSORI, in questo caso, per ventilatori EC.

                End If


            Else

                ' Finisce il CheckBox10
            End If



            ' -------------------//----------------------------------------------------------------------------
            ' Shock Absorbers ------  Cristiano Gnesutta, 5th October 2012
            ' -----------------//------------------------------------------------------------------------------

            If item17 Then

                AccessoriesCosts = AccessoriesCosts + accessories.Find(Function(x) x.CondenserId = conderserId).ShockAbsorber

