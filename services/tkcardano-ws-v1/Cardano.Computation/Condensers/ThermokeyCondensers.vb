                        AccessoriesCosts = AccessoriesCosts + accessories.Find(Function(x) x.CondenserId = conderserId).ThreePoleRepairSwitchI

                        detail.AccessoriesItems.Add(New AccessoriesItemList With {
                                 .Item = "3 Pole RS I",
                                 .Price = accessories.Find(Function(x) x.CondenserId = conderserId).ThreePoleRepairSwitchI
