        If ((thisNoiseMaxLevel < 15 + thisThermokeyNoise) And (thisNoiseMaxLevel > thisThermokeyNoise - 5)) Then
            thisSoundPressureLevelCheck = False
        Else
            thisSoundPressureLevelCheck = True

