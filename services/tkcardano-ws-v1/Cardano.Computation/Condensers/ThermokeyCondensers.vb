                    End Select

            End Select


            ' Aggiunta pressione alle funzioni termodinamiche da Cristiano Gnesutta il 15 Marzo 2015

            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

            'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
            Select Case True

                'NEW REFRIGERANTS - Added by C. Gnesutta on April 26th 2018. -OK
                'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                Case ((refRigerantType = "R-32") Or (refRigerantType = "R-245fa") Or (refRigerantType = "R-407F") Or (refRigerantType = "R-449a") Or (refRigerantType = "R-513a") Or (refRigerantType = "R-600") Or
                      (refRigerantType = "R-600a") Or (refRigerantType = "R-1234yf") Or (refRigerantType = "R-1234ze"))

                    'Air flow in [m^3/h] - Ok- Checked again by C. Gnesutta on June 26th 2018. - Air Flow Units -Final Check: OK
                    ThetaPascal = NewRefrigerantsEngine.FinalCalculationRefrigerantSidePressureDrop(_microchannelTubeWidth, thisCoilType, thisCoilLength, refRigerantType, (60 * thisAirFlow), (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), _metricCondTemper, (5 / 9 * CondenserDeSuperHeatDegrees(unitsType, compressor)), (5 / 9 * CondenserSubCoolDegrees(unitsType, subCooling)), Tk_ViscosityAirStd, Tk_SpecificHeatAirStd, Tk_ThermalConductivityAirStd, Tk_DensityAirStd, atmPressureInMetric)

                    ThetaCourant = ThermokeyCondenserCapacities.CoilStandardAirPressureDrop(thisCoilType, thisCoilLength, "R-404A", thisAirFlow, atmPressureInMetric)

                    'NH3 (Ammoniaca) - Aggiunta da C. Gnesutta, 23 Luglio 2019.

                    'OK- Checked by C. Gnesutta on July 31st, 2019.
                    'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                Case (refRigerantType = "R717-(NH3)")

                    'TkMicro25/NH3 - C. Gnesutta, July 23rd, 2019.
                    'OK- Checked by C. Gnesutta on July 31st, 2019.
                    If (condensers(Me._IdCondenserModel - 1).Series = "MC") Then

                        'TkMicro25/NH3 (ammonia) - Refrigerant Side pressure Drops - C. Gnesutta, July 24th, 2019.
                        'OK- Checked by C. Gnesutta on July 31st, 2019. - TkMicro25
                        ThetaPascal = TkMicro25_NH3.RefrigerantPressureDrop_NH3_TkMicro25(thisCoilType_NH3, thisCoilLength, (60 * thisAirFlow), (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), atmPressureInMetric)

                        'TkMicro25/NH3 (ammonia) - Air Side Pressure Drops - C. Gnesutta, July 24th, 2019.
                        'OK- Checked by C. Gnesutta on July 31st, 2019.- TkMicro25
                        ThetaCourant = TkMicro25_NH3.AirPressureDrop_NH3_TkMicro25(thisCoilType_NH3, thisCoilLength, (60 * thisAirFlow), atmPressureInMetric)

                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                        'AMMONIA - Microcanale 32 mm
                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                        'TkMicro32/NH3 - C. Gnesutta, July 23rd, 2019.
                        'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                    Else

                        'TkMicro32/NH3 (ammonia) - Refrigerant Side pressure Drops - C. Gnesutta, July 24th, 2019.
                        'OK- Checked by C. Gnesutta on July 31st, 2019. - TkMicro32
                        ThetaPascal = TkMicro32_NH3.RefrigerantPressureDrop_NH3_TkMicro32(thisCoilType_NH3, thisCoilLength, (60 * thisAirFlow), (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), atmPressureInMetric)

                        'TkMicro32/NH3 (ammonia) - Air Side Pressure Drops - C. Gnesutta, July 24th, 2019.
                        'OK- Checked by C. Gnesutta on July 31st, 2019.- TkMicro32
                        ThetaCourant = TkMicro32_NH3.AirPressureDrop_NH3_TkMicro32(thisCoilType_NH3, thisCoilLength, (60 * thisAirFlow), atmPressureInMetric)


                    End If


                    'OLD REFRIGERANTS- Added by C. Gnesutta on April 26th 2018. -OK
                    'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                Case Else

                    ThetaPascal = ThermokeyCondenserCapacities.CoilStandardRefrigerantPressureDrop(thisCoilType, thisCoilLength, refRigerantType, thisAirFlow, (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), atmPressureInMetric)

                    ThetaCourant = ThermokeyCondenserCapacities.CoilStandardAirPressureDrop(thisCoilType, thisCoilLength, refRigerantType, thisAirFlow, atmPressureInMetric)

            End Select

            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€



            'C. Gnesutta, 19 luglio 2019.
            Select Case True

                'Nuovi refrigeranti - C. Gnesutta, 19 Luglio 2019.

                'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                Case ((refRigerantType = "R-32") Or (refRigerantType = "R-245fa") Or (refRigerantType = "R-407F") Or (refRigerantType = "R-449a") Or (refRigerantType = "R-513a") Or (refRigerantType = "R-600") Or
                      (refRigerantType = "R-600a") Or (refRigerantType = "R-1234yf") Or (refRigerantType = "R-1234ze"))


                    'Qui non bisogna fare nulla, perché le perdite di carico lato refrigerante per i nuovi refrigeranti sono particolari.


                    'NOTHING

                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                    'NH3-Ammonia. C. Gnesutta, 19 Luglio 2019.
                    'OK- Checked by C. Gnesutta on July 31st, 2019.
                    'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                Case (refRigerantType = "R717-(NH3)")

                    Select Case True
                        Case ThetaPascal < 5
                            detail.Refrigent_Error = "Be careful ! The refrigerant side pressure drop Is too small !"

                        Case ThetaPascal > 100
                            detail.Refrigent_Error = "Be careful ! The refrigerant side pressure drop Is too high !"
                        Case ThetaCourant > 150

                            detail.Refrigent_Error = "Be careful ! The air side pressure drop Is too high !"
                    End Select

                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                    'OLD REFRIGERANTS
                    'Refrigeranti tradizionali - C. Gnesutta, 19 Luglio 2019.
                    'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                Case Else

                    Select Case True
                        Case ThetaPascal < 5
                            detail.Refrigent_Error = "Be careful ! The refrigerant side pressure drop Is too small !"

                        Case ThetaPascal > 100
                            MsgBox("Be careful ! The refrigerant side pressure drop Is too high !")
                        Case ThetaCourant > 150

                            detail.Refrigent_Error = "Be careful ! The air side pressure drop Is too high !"
                    End Select

            End Select

            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


            'Material

            Dim materialResults As Tuple(Of String, String) = GetMaterialCasing(condensers, i)
            detail.MaterialCasing = materialResults.Item1
            detail.MainMaterial = materialResults.Item2

            detail.Position_connection = GeometricPositionOfConnections(condensers, i, refRigerantType)

        Catch ex As Exception

        End Try

        detailsList.Add(detail)

        Return detailsList

    End Function
    Private Function GeometricPositionOfConnections(condensers As List(Of Condenser), ByVal CondenserModelId As Int16, refRigerantType As String) As String
        Dim rtval As String = ""

        'Caso ammoniaca - C. Gnesutta, 8 Agosto 2019.
        If (refRigerantType = "R717-(NH3)") Then

            'MsgBox(Me.MicrochannelCondenserSystemII1.NumberOfPasses_NH3(foundIdCM))

            If (condensers(CondenserModelId).Num_Of_Passes_NH3 Mod 2 = 0) Then

                rtval = "Same Side"

            Else

                rtval = "Opposite Side"

            End If

        Else


            If (condensers(CondenserModelId).Num_Of_Passes Mod 2 = 0) Then

                rtval = "Same Side"

            Else
                rtval = "Opposite Side"

            End If
        End If

        Return rtval

    End Function

    Public Function GetMaterialCasing(condensers As List(Of Condenser), CondenserModelId As Int32) As Tuple(Of String, String)

        Dim materialCasing As String = ""
        Dim mainMaterial As String = ""

        Try
            Dim model As String = condensers(CondenserModelId).Model

            If Microsoft.VisualBasic.Left(model, 3) = "TMC" Then
                mainMaterial = "Aluminium"
                materialCasing = "Aluminium"
            Else
                If CondenserModelId > 418 Then
                    mainMaterial = "Aluminium"
                    materialCasing = "Aluminium"
                Else
                    mainMaterial = "Galvanised Steel RAL 9010"
                    materialCasing = "Galvanised Steel"
                End If
            End If

        Catch ex As Exception

        End Try

        Return Tuple.Create(materialCasing, mainMaterial)

    End Function

