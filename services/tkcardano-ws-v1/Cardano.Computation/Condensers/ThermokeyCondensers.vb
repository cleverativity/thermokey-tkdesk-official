                            .Rpm = Math.Round(FansEcDataAtWP.RadialSpeed(thisEC_FanName, _thisEC_FanFlowRate_EC_1Phase_B2, thisEC_DpAir), 0),
                            .Power = Math.Round(FansEcDataAtWP.ElectricPower(thisEC_FanName, _thisEC_FanFlowRate_EC_1Phase_B2, thisEC_DpAir), 0),
                            .Current_a = Math.Round(FansEcDataAtWP.ElectricCurrent(thisEC_FanName, _thisEC_FanFlowRate_EC_1Phase_B2, thisEC_DpAir), 2).ToString("F2"),
                            .Internal_volume = Internal_volume,
                            .Weights = Weights,
                           .Inlet_connection = Inlet_connection,
                           .Outlet_connection = Outlet_connection,
                           .Price = thisCondenserPrice
                            })
                                tempId += 1

                                '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                'C. Gnesutta, February 1st, 2021.
                                'C. Gnesutta, February 4th, 2021.
                                thisColumnFinalRowCount = thisColumnFinalRowCount + 1

                                'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

                            Case Else
                        End Select


                    Else

                    End If

                Next kj

            Next ki


            Return detailsList

        Catch nex As NullReferenceException
            ' Handle NullReferenceException specifically (e.g., when Capacity or other objects are Nothing)
            Dim emptyList As New List(Of ComputationResults)
            ' Log the error for debugging
            System.Diagnostics.Debug.WriteLine("NullReferenceException in ReportCapacitySearch: " & nex.Message & vbCrLf & nex.StackTrace)
            Return emptyList

        Catch ex As Exception
            ' Handle other exceptions
            Dim emptyList As New List(Of ComputationResults)
            ' Log the error for debugging
            System.Diagnostics.Debug.WriteLine("Exception in ReportCapacitySearch: " & ex.Message & vbCrLf & ex.StackTrace)
            Return emptyList
        End Try
    End Function

    Private Function RefrigerantPressureDropCheck(ByVal foundIdCM As Int16, ByVal thisElectricalConnection As String, condensing As Double, refRigerantType As String, atmPressureInMetric As Double, unitsType As String, subCooling As Double, compressor As Double, dryBulb As Double) As Boolean


        Dim _metricCondTemper As Double = Me.convertValue.DegCfromDegF(CondensingTemperature(unitsType, condensing))

        Dim thisRefrigerantPressureDropCheck As Boolean = False

        'Modified on 6th December 2011
        ' Modificato nuovamente da Cristiano Gnesutta (abbassato da 140 kPa a 100 kPa) il 23 Ottobre 2015, come disposto da Sandro Ortolano
        ' Riportato  nuovamente da Cristiano Gnesutta al vecchio valore il 2 dicembre 2015, per problema riguardante numero di entrate fisse
        Dim thisMaxRefrigerantPressureDrop As Double = 140 'Maximum Refrigerant Pressure Drops (100 kPa)

        Dim thisMinRefrigerantPressureDrop As Double = 5 'Minimum Refrigerant Pressure Drops (5 kPa)

        Dim ThermokeyCondenserCapacitiesRefrigerantDP As New ThermokeyCondenserCapacities

        Dim thisRefrigerantPressureDrop As Double
        Dim thisCoilType As String

        Dim thisCoilType_NH3 As String

        Dim thisCoilLength As Double
        Dim thisRefType As String = refRigerantType
        Dim thisNumberOfCoils As Int16
        Dim thisAirFlow As Double

        Dim thisFansFlow As Double = 0

        thisCoilType = condensers(foundIdCM - 1).Coil_Type


        thisCoilLength = condensers(foundIdCM - 1).Coil_Length
        thisNumberOfCoils = condensers(foundIdCM - 1).Number_Coils

        'Aggiunta da C. Gnesutta il 30 Luglio 2019.
        thisCoilType_NH3 = condensers(foundIdCM - 1).Coil_Type_NH3


        'MODIFIED BY CRISTIANO GNESUTTA ON 13th DECEMBER 2011
        'MODIFIED AGAIN BY C. GNESUTTA ON 21st January 2021.


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'Mofificata, nuovamente, da C. Gnesutta il 22 Gennaio 2020.

        Select Case True

            'C. Gnesutta, 22 Gennaio 2021 -  Refrigerant Pressure Drops (AC DELTA 3Phases/400 Volt)
            Case thisElectricalConnection = "AC-Delta-3Ph-400V~50Hz"
                thisFansFlow = condensers(foundIdCM - 1).Delta_Fans_Flow


                'C. Gnesutta, 22 Gennaio 2021 -  Refrigerant Pressure Drops (AC STAR 3Phases/400 Volt)
            Case thisElectricalConnection = "AC-Star-3Ph-400V~50Hz"
                thisFansFlow = condensers(foundIdCM - 1).Star_Fans_Flow


                'C. Gnesutta, 22 Gennaio 2021  -  Refrigerant Pressure Drops (AC MonoPhase 1Ph/230 Volt)
            Case thisElectricalConnection = "AC-1Ph-230V~50Hz"
                thisFansFlow = condensers(foundIdCM - 1).Delta_Fans_Flow



        End Select

        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'This equation divides the global air flow rate into each single core
        'OK - Checked by C. Gnesutta on June 22nd 2018.
        thisAirFlow = (thisFansFlow / thisNumberOfCoils) / 60
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'Dp Refrigerant - NEW Refrigerants - Added by C. Gnesutta on April 26th 2018.

        'C. Gnesutta, July 22nd, 2019.
        Select Case True

            Case ((thisRefType = "R-32") Or (thisRefType = "R-245fa") Or (thisRefType = "R-407F") Or (thisRefType = "R-449a") Or (thisRefType = "R-513a") Or (thisRefType = "R-600") Or
                  (thisRefType = "R-600a") Or (thisRefType = "R-1234yf") Or (thisRefType = "R-1234ze"))

                'Temporary value of the refrigerant side pressure drops - NEW refrigerants. C. Gnesutta on April 26th 2018. -OK
                '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                'ADDED by C. Gnesutta on June 22nd 2018. Checked by C. Gnesutta on June 25th 2018. Air Flow rate in [m^3/h].
                'Air flow in [m^3/h] - Ok- Checked again by C. Gnesutta on June 26th 2018. - Air Flow Units-Final Check: OK
                thisRefrigerantPressureDrop = NewRefrigerantsEngine.CoilThermalCapacity(_microchannelTubeWidth, thisCoilType, thisCoilLength, refRigerantType, (60 * thisAirFlow), (5 / 9) * (Me.CondensingTemperature(unitsType, CondensingTemperature(unitsType, condensing)) - dryBulb), _metricCondTemper, (5 / 9 * CondenserDeSuperHeatDegrees(unitsType, compressor)), (5 / 9 * CondenserSubCoolDegrees(unitsType, subCooling)), Tk_ViscosityAirStd, Tk_SpecificHeatAirStd, Tk_ThermalConductivityAirStd, Tk_DensityAirStd, atmPressureInMetric)

                '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                'NH3 (Ammoniaca) - Aggiunta da C. Gnesutta, 23 Luglio 2019.
                'OK - Checked by C. Gnesutta on July 31st, 2019. - NH3
                'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
            Case (thisRefType = "R717-(NH3)")

                'NH3 (Ammoniaca) - Aggiunta da C. Gnesutta, 23 Luglio 2019.
                'OK - Checked by C. Gnesutta on July 31st, 2019. - NH3
                If (condensers(foundIdCM - 1).Series = "MC") Then

                    'TkMicro25/NH3 - C. Gnesutta, July 23rd, 2019.
                    'OK - Checked by C. Gnesutta on July 31st, 2019. - NH3
                    'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                    thisRefrigerantPressureDrop = TkMicro25_NH3.RefrigerantPressureDrop_NH3_TkMicro25(thisCoilType_NH3, thisCoilLength, (60 * thisAirFlow), (5 / 9) * (Me.CondensingTemperature(unitsType, CondensingTemperature(unitsType, condensing)) - dryBulb), atmPressureInMetric)

                    'NH3/TkMicro32
                Else

                    'TkMicro32/NH3 - C. Gnesutta, July 23rd, 2019.
                    'OK - Checked by C. Gnesutta on July 31st, 2019. - NH3
                    'Correzione effettuata da C. Gnesutta il 07 Agosto 2019.
                    thisRefrigerantPressureDrop = TkMicro32_NH3.RefrigerantPressureDrop_NH3_TkMicro32(thisCoilType_NH3, thisCoilLength, (60 * thisAirFlow), (5 / 9) * (Me.CondensingTemperature(unitsType, CondensingTemperature(unitsType, condensing)) - dryBulb), atmPressureInMetric)

                End If

                'Dp Refrigerant - OLD Refrigerants - Added by C. Gnesutta on April 26th 2018.
            Case Else

                ' Aggiunta pressione a funzioni termodinamiche da Cristiano Gnesutta il 16 Marzo 2015 -OK
                thisRefrigerantPressureDrop = ThermokeyCondenserCapacitiesRefrigerantDP.CoilStandardRefrigerantPressureDrop(thisCoilType, thisCoilLength, thisRefType, thisAirFlow, (5 / 9) * (Me.CondensingTemperature(unitsType, CondensingTemperature(unitsType, condensing)) - dryBulb), atmPressureInMetric)


        End Select

        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


        If thisRefrigerantPressureDrop >= thisMaxRefrigerantPressureDrop Or thisRefrigerantPressureDrop <= thisMinRefrigerantPressureDrop Then
            thisRefrigerantPressureDropCheck = True
        Else
            thisRefrigerantPressureDropCheck = False
        End If



        Return thisRefrigerantPressureDropCheck

    End Function

    Private Function AirPressureDropCheck(ByVal foundIdCM As Int16, ByVal thisElectricalConnection As String, refRigerantType As String, atmPressureInMetric As Double) As Boolean

        Dim thisAirPressureDropCheck As Boolean

        Dim thisMaxAirPressureDrop As Double = 150 'Maximum Air Pressure Drops (150 Pa)
        Dim ThermokeyCondenserCapacitiesAirDP As New ThermokeyCondenserCapacities
        Dim thisAirPressureDrop As Double
        Dim thisCoilType As String

        Dim thisCoilLength As Double
        Dim thisCoilTypeNH3 As String

        Dim thisRefType As String = refRigerantType
        Dim thisNumberOfCoils As Int16
        Dim thisAirFlow As Double

        Dim thisFansFlow As Double

        thisCoilType = condensers(foundIdCM - 1).Coil_Type

        thisCoilTypeNH3 = condensers(foundIdCM - 1).Coil_Type_NH3

        thisCoilLength = condensers(foundIdCM - 1).Coil_Length
        thisNumberOfCoils = condensers(foundIdCM - 1).Number_Coils


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'Mofificata, nuovamente, da C. Gnesutta il 22 Gennaio 2020.
        Select Case True

            'C. Gnesutta, 22 Gennaio 2021 - Air Pressure Drops (AC DELTA 3Phases/400 Volt)
            Case (thisElectricalConnection = "AC-Delta-3Ph-400V~50Hz")

                thisFansFlow = condensers(foundIdCM - 1).Delta_Fans_Flow


                'C. Gnesutta, 22 Gennaio 2021 - Air Pressure Drops (AC STAR 3Phases/400 Volt)
            Case (thisElectricalConnection = "AC-Star-3Ph-400V~50Hz")

                thisFansFlow = condensers(foundIdCM - 1).Star_Fans_Flow


                'C. Gnesutta, 22 Gennaio 2021  - Air Pressure Drops (AC MonoPhase 1Ph/230 Volt)
            Case (thisElectricalConnection = "AC-1Ph-230V~50Hz")

                thisFansFlow = condensers(foundIdCM - 1).Delta_Fans_Flow


            Case Else

        End Select

        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'This equation divides the global air flow rate into each single core
        'OK - Checked by C. Gnesutta on June 22nd 2018.
        thisAirFlow = (thisFansFlow / thisNumberOfCoils) / 60
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

        ' Aggiunta presssione a funzioni termodinamiche da Cristiano Gnesutta il 16 Marzo 2015


        'MODIFICATA NUOVAMENTE DA C. Gnesutta il 22 Luglio 2019.

        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'AIR SIDE PRESSURE DROPS - C. Gnesutta, April 26th 2018.
        'OK Checked by C. Gnesutta on April 26th 2018.


        Select Case True

            Case ((thisRefType = "R-32") Or (thisRefType = "R-245fa") Or (thisRefType = "R-407F") Or (thisRefType = "R-449a") Or (thisRefType = "R-513a") Or (thisRefType = "R-600") Or
                  (thisRefType = "R-600a") Or (thisRefType = "R-1234yf") Or (thisRefType = "R-1234ze"))

                'thisAirFlow = thisAirFlow * 60

                'NEW REFRIGERANTS
                thisAirPressureDrop = ThermokeyCondenserCapacitiesAirDP.CoilStandardAirPressureDrop(thisCoilType, thisCoilLength, "R-404A", thisAirFlow, atmPressureInMetric)


                'NH3 (Ammoniaca) - Aggiunta da C. Gnesutta, 23 Luglio 2019.
                'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.

            Case (thisRefType = "R717-(NH3)")

                'TkMicro25/NH3 - C. Gnesutta, July 23rd, 2019.

                'Ok - ricontrollato da C. Gnesutta il 28 Agosto 2019.
                If (condensers(foundIdCM - 1).Series = "MC") Then

                    'OK - Checked by C. Gnesutta on July 31st, 2019. - TkMicro25/NH3
                    thisAirPressureDrop = TkMicro25_NH3.AirPressureDrop_NH3_TkMicro25(thisCoilTypeNH3, thisCoilLength, 60 * thisAirFlow, atmPressureInMetric)

                    'TkMicro32/NH3 - C. Gnesutta, July 23rd, 2019.
                Else

                    'OK - Checked by C. Gnesutta on July 31st, 2019. - TkMicro32/NH3
                    thisAirPressureDrop = TkMicro32_NH3.AirPressureDrop_NH3_TkMicro32(thisCoilTypeNH3, thisCoilLength, 60 * thisAirFlow, atmPressureInMetric)

                End If

            Case Else

                'OLD REFRIGERANTS
                thisAirPressureDrop = ThermokeyCondenserCapacitiesAirDP.CoilStandardAirPressureDrop(thisCoilType, thisCoilLength, thisRefType, thisAirFlow, atmPressureInMetric)

        End Select


        ' Modificato da Cristiano Gnesutta il 7 Luglio 2015
        If (thisAirPressureDrop >= thisMaxAirPressureDrop Or thisFansFlow <= 10) Then
            thisAirPressureDropCheck = True
        Else
            thisAirPressureDropCheck = False
        End If



        Return thisAirPressureDropCheck

    End Function


    Private Function SoundPressureLevelCheck(splValue As Double, distance As Double, ByVal foundIdCM As Int16, ByVal thisElectricalConnection As String, unitsType As String, flowDirection As String) As Boolean

        Dim thisSoundPressureLevelCheck As Boolean = False

        Dim thisThermokeyNoise As Double = 0
        Dim thisNoiseMaxLevel As Double = 65

        thisNoiseMaxLevel = splValue

        ' NOISE OF THE MACHINE. C. Gnesutta, December 2011
        Select Case Me.AirFlowDirection(unitsType, flowDirection)
            Case "Vertical"
                FanNoiseMachine.MachineHeight = condensers(foundIdCM - 1).Vertical_Machine_Height / 1000
                FanNoiseMachine.DistanceFromMachine = distance
                FanNoiseMachine.MachineLength = condensers(foundIdCM - 1).Vertical_Machine_Length / 1000
                FanNoiseMachine.MachineWidth = condensers(foundIdCM - 1).Vertical_Machine_Width / 1000

            Case "Horizontal"
                ' Struttura decisionale, per risolvere problematiche legate alla tipologia di condensatore remoto
                ' C. Gnesutta, 07 Dicembre 2022. Aggiunti Condensatori Remoto Modulare.
                If (Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 3) = "JMC" Or Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 5) = "2XJMC" Or Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 3) = "3XJMC" Or Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 3) = "JMK" Or Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 3) = "2XJMK" Or Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 3) = "3XJMK" Or
Microsoft.VisualBasic.Left(condensers(foundIdCM - 1).Model, 3) = "TMC") Then

                    FanNoiseMachine.MachineHeight = condensers(foundIdCM - 1).Vertical_Machine_Height / 1000
                    FanNoiseMachine.DistanceFromMachine = distance
                    FanNoiseMachine.MachineLength = condensers(foundIdCM - 1).Vertical_Machine_Length / 1000
                    FanNoiseMachine.MachineWidth = condensers(foundIdCM - 1).Vertical_Machine_Width / 1000


                Else
                    FanNoiseMachine.MachineHeight = condensers(foundIdCM - 1).Horizontal_Machine_Height / 1000
                    FanNoiseMachine.DistanceFromMachine = distance
                    FanNoiseMachine.MachineLength = condensers(foundIdCM - 1).Horizontal_Machine_Length / 1000
                    FanNoiseMachine.MachineWidth = condensers(foundIdCM - 1).Horizontal_Machine_Width / 1000
                End If


            Case Else
        End Select

        'MODIFIED BY CRISTIANO GNESUTTA ON 13th DECEMBER 2011
        'Mofificata, nuovamente, da C. Gnesutta il 20 Dicembre 2020, a seguito dell'introduzione della nuova struttura di selezione
        'volta a gestire i ventilatori EC


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'Mofificata, nuovamente, da C. Gnesutta il 22 Gennaio 2020.
        Select Case True


            'C. Gnesutta, 22 Gennaio 2021 - NOISE OF THE MACHINE (AC DELTA 3Phases/400 Volt)
            Case thisElectricalConnection = "AC-Delta-3Ph-400V~50Hz"

