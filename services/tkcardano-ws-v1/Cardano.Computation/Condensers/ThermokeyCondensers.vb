                                        thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                        'C. Gnesutta, December 9th, 2020-EC -Ziehl-Abegg: (EC/1Ph-230V~50Hz) - (<<NEW>> REFRIGERANTS)- (B2)- (<<NEW>> REFRIGERANTS) - Ok
                                        thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


