                                        thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


