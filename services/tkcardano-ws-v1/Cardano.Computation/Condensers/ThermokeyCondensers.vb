                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = (ThermalCapacityCorrections * thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) * condensers(idCM - 1).Number_Coils)

                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

