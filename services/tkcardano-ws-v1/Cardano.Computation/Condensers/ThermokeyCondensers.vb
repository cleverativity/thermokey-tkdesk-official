    Private Function NewEC_Fans_RefrigerantPressureDropCheck(ByVal found_EC_IdCM As Int16, ByVal found_EC_Index As Int16, ByVal foundFanType As String, refRigerantType As String, unitsType As String, condensing As Double, atmPressureInMetric As Double, subCooling As Double, compressor As Double, dryBulb As Double) As Boolean


        Dim this_NewEC_DpRefrigerant As New ThermokeyCondenserCapacities

        Dim this_NewEC_RefrigerantPressureDropCheck As Boolean = True

        Dim this_NewEC_FansFlow As Single = 0

        'Selected refrigerant type. C. Gnesutta, 17 Diembre 2020.
        Dim this_NewEC_RefType As String = refRigerantType

        Dim this_Max_NewEC_DpRefr As Double = 140 'Maximum Refrigerant Pressure Drops (140 kPa)

        Dim this_Min_NewEC_DpRefr As Double = 5 'Minimum Refrigerant Pressure Drops (5 kPa)

        Dim thisDpRefr As Double = 0

        Dim _metric_NewEC_CondTemp As Double = Me.convertValue.DegCfromDegF(CondensingTemperature(unitsType, condensing))


        'EC Fans - EBM-Papst
        If (foundFanType = "B1") Then

            Select Case True

                Case (found_EC_Index = 0)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve1_FlowRate_EBMPapst(found_EC_IdCM - 1)

                Case (found_EC_Index = 1)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve2_FlowRate_EBMPapst(found_EC_IdCM - 1)

                Case (found_EC_Index = 2)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve3_FlowRate_EBMPapst(found_EC_IdCM - 1)

                Case (found_EC_Index = 3)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve4_FlowRate_EBMPapst(found_EC_IdCM - 1)
                Case (found_EC_Index = 4)
                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve5_FlowRate_EBMPapst(found_EC_IdCM - 1)

                Case (found_EC_Index = 5)
                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve6_FlowRate_EBMPapst(found_EC_IdCM - 1)
                Case Else
            End Select


            'EC Fans - Ziehl-Abegg
            ' C. Gnesutta, 17 Dicembre 2020.
        Else


            Select Case True

                Case (found_EC_Index = 0)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve1_FlowRate_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 1)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve2_FlowRate_Ziehl(found_EC_IdCM - 1)


                Case (found_EC_Index = 2)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve3_FlowRate_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 3)

                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve4_FlowRate_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 4)
                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve5_FlowRate_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 5)
                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve6_FlowRate_Ziehl(found_EC_IdCM - 1)
                Case Else
            End Select

        End If


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'C. Gnesutta, 17 Dicembre 2020.
        Dim this_NewEC_CoilType As String = condensers(found_EC_IdCM - 1).Coil_Type

        Dim this_NewEC_CoilTypeNH3 As String = condensers(found_EC_IdCM - 1).Coil_Type_NH3

        Dim this_NewEC_CoilLength As Double = condensers(found_EC_IdCM - 1).Coil_Length

        Dim this_NewEC_NumberOfCoils As Double = condensers(found_EC_IdCM - 1).Number_Coils
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'In questa equazione vengo calcolati i flussi d'aria su ogni batteria ed espressi in [m^3/min]
        'C. Gnesutta 17 Dicembre 2020.
        this_NewEC_FansFlow = (this_NewEC_FansFlow / this_NewEC_NumberOfCoils) / 60
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

        Select Case True

            Case ((this_NewEC_RefType = "R-32") Or (this_NewEC_RefType = "R-245fa") Or (this_NewEC_RefType = "R-407F") Or (this_NewEC_RefType = "R-449a") Or (this_NewEC_RefType = "R-513a") Or (this_NewEC_RefType = "R-600") Or (this_NewEC_RefType = "R-600a") Or (this_NewEC_RefType = "R-1234yf") Or (this_NewEC_RefType = "R-1234ze"))


                thisDpRefr = NewRefrigerantsEngine.FinalCalculationRefrigerantSidePressureDrop(_microchannelTubeWidth, this_NewEC_CoilType, this_NewEC_CoilLength, this_NewEC_RefType, (60 * this_NewEC_FansFlow), (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), _metric_NewEC_CondTemp, (5 / 9 * CondenserDeSuperHeatDegrees(unitsType, compressor)), (5 / 9 * CondenserSubCoolDegrees(unitsType, subCooling)), Tk_ViscosityAirStd, Tk_SpecificHeatAirStd, Tk_ThermalConductivityAirStd, Tk_DensityAirStd, atmPressureInMetric)



            Case (this_NewEC_RefType = "R717-(NH3)")

                If (condensers(found_EC_IdCM - 1).Series = "MC") Then

                    thisDpRefr = TkMicro25_NH3.RefrigerantPressureDrop_NH3_TkMicro25(this_NewEC_CoilTypeNH3, this_NewEC_CoilLength, (60 * this_NewEC_FansFlow), (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), atmPressureInMetric)
                Else
                    thisDpRefr = TkMicro32_NH3.RefrigerantPressureDrop_NH3_TkMicro32(this_NewEC_CoilTypeNH3, this_NewEC_CoilLength, (60 * this_NewEC_FansFlow), (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), atmPressureInMetric)
                End If

            Case Else

                thisDpRefr = this_NewEC_DpRefrigerant.CoilStandardRefrigerantPressureDrop(this_NewEC_CoilType, this_NewEC_CoilLength, this_NewEC_RefType, this_NewEC_FansFlow, (5 / 9) * (CondensingTemperature(unitsType, condensing) - dryBulb), atmPressureInMetric)


        End Select


        ' C. Gnesutta, 17 Dicembre 2020.
        If (thisDpRefr >= this_Max_NewEC_DpRefr Or thisDpRefr <= this_Min_NewEC_DpRefr) Then

            this_NewEC_RefrigerantPressureDropCheck = True
        Else

            this_NewEC_RefrigerantPressureDropCheck = False
        End If


        Return this_NewEC_RefrigerantPressureDropCheck
    End Function

    Private Function NewEC_Fans_AirPressureDropCheck(ByVal found_EC_IdCM As Int16, ByVal found_EC_Index As Int16, ByVal foundFanType As String) As Boolean


        Dim this_NewEC_Fans_AirPressureDropCheck As Boolean = True

        Dim this_NewEC_DpAir As Single = 0

        Dim this_Max_NewEC_DpAir As Double = 150 'Maximum Refrigerant Pressure Drops (100 kPa)

