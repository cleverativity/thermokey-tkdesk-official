                FanNoiseMachine.DistanceFromMachine = distance
                FanNoiseMachine.MachineLength = condensers(found_EC_IdCM - 1).Vertical_Machine_Length / 1000
                FanNoiseMachine.MachineWidth = condensers(found_EC_IdCM - 1).Vertical_Machine_Width / 1000

            Case "Horizontal"
                ' Struttura decisionale, per risolvere problematiche legate alla tipologia di condensatore remoto: queste macchine sono soltanto a Flusso d'arua verticale.
                'C. Gnesutta, 17 dicembre 2020

                'Modificato da C. Gnesutta il 07 Dicembre 2022 per introduzione Condensatori Remoti Modulari
                If (Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 3) = "JMC" Or Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 5) = "2XJMC" Or Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 5) = "3XJMC" Or Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 3) = "JMK" Or Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 3) = "2XJMK" Or Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 3) = "3XJMK" Or Microsoft.VisualBasic.Left(condensers(found_EC_IdCM - 1).Model, 3) = "TMC") Then
