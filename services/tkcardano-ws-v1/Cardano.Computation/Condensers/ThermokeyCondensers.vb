                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                    'C. Gnesutta, December 7th, 2020. - EC-Ziehl/Abbeg:(3Ph-400V~50Hz) (NEW Refrigerants)-Ok
                                    thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", (this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


