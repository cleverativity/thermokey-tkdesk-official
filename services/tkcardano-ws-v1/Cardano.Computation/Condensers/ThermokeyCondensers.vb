            '        End If
            '    Next
            'End If


            Dim foundAccessory = accessories.Find(Function(x) x.CondenserId = conderserId)
            If foundAccessory IsNot Nothing Then
                AccessoriesCosts = AccessoriesCosts + foundAccessory.Packaging
            End If

            detail.RemoteModel = NameOfTheCondenserForAccessories

            detail.AccessoriesPrice = AccessoriesCosts

            detail.AccessoriesDiscount = accessoriesDiscount

            detail.UnitDiscount = unitDiscount

            detail.Discount = (accessoriesDiscount / 100) * detail.AccessoriesPrice + (unitDiscount / 100) * Val(detail.UnitPrice)

            detail.TotalNetPrice = Int((100 - unitDiscount) * Val(10 * detail.UnitPrice) / 1000 + ((100 - accessoriesDiscount) / 100) * AccessoriesCosts)

            detailsList.Add(detail)

        Catch ex As Exception

        End Try

        Return detailsList
    End Function




