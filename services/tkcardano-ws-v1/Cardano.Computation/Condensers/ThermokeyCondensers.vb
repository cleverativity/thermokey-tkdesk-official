        FanNoiseMachine.TotalLWA = FansEcDataAtWP.RadiatedNoise(this_NewEC_FanName, this_NewEC_FansFlow / (condensers(found_EC_IdCM - 1).Num_Of_Fan_Rows * condensers(found_EC_IdCM - 1).Num_Of_Fan_Per_Row), this_NewEC_DpAir)

