                                    'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                                    thisCoilCapacity_EC_3Ph_EBM_Papst(idCM - 1, EC_Index) = (thisCoilCapacity_EC_3Ph_EBM_Papst(idCM - 1, EC_Index) * thisC3)

                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

