                                NameOfTheCondenserForAccessories = NameOfTheCondenserForAccessories & "Q[I3]"

                                AccessoriesCosts = AccessoriesCosts + accessories.Find(Function(x) x.CondenserId = conderserId).ThreePoleRepairSwitchI + accessories.Find(Function(x) x.CondenserId = conderserId).WiringWithElectricPanelQ

                                detail.AccessoriesItems.Add(New AccessoriesItemList With {
                                         .Item = "Wir. with EP Q - 3 Pole RS",
                                         .Price = accessories.Find(Function(x) x.CondenserId = conderserId).ThreePoleRepairSwitchI + accessories.Find(Function(x) x.CondenserId = conderserId).WiringWithElectricPanelQ
                                     })



                            Case Else
                        End Select

                    End If
                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

