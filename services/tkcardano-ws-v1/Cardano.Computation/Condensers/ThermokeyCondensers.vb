                                Case (EC_Index = 4)
                                    this_EC_FansFlow_1Ph_230V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve5_FlowRate_Ziehl(idCM - 1)

                                    'EC-Ziehl-Abegg: (1Ph-230V~50Hz) - Curve6  -C. Gnesutta, December 9th, 2020.- (B2)- (<<NEW>> REFRIGERANTS)- Ok
                                Case (EC_Index = 5)

