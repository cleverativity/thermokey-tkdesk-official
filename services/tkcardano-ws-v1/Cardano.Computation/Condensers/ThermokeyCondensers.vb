                                 })

            End If


            If item18 Then

                AccessoriesCosts = AccessoriesCosts + accessories.Find(Function(x) x.CondenserId = conderserId).PaintingOfCoolingFins

                NameOfTheCondenserForAccessories = NameOfTheCondenserForAccessories & "S"

                detail.AccessoriesItems.Add(New AccessoriesItemList With {
