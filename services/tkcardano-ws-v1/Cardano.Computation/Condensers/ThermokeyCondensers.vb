                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)



                                        'Non-Standard SubCooling e DeSuperheating  - (NEW REFRIGERANTS)- OK
                                        If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then


                                            'TkMicro32/NH3(Ammonia- EC/1Phase - 230V/50Hz - EC-EBM Papst -  C. Gnesutta, December 3rd, 2020.- OK
                                            thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)



                                            'TkMicro32/NH3(Ammonia- EC/1Phase - 230V/50Hz - EC-EBM Papst -  C. Gnesutta, December 3rd, 2020.- OK
                                            thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                        Else


