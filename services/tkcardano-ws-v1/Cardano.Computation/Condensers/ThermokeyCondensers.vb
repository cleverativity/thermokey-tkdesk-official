                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                        'NON CI SONO VENTILATORI EC SULLA SERIE TkSmart

                                    Else


                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                        'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro32 -  (EC-3Ph-400V-(B2)~50Hz)
                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                        'TkMicro32/NH3(Ammonia) - EC-Ziehl/Abbeg: 400V~50Hz-  C. Gnesutta,  December 7th, 2020.-Ok
                                        thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                        'TkMicro32/NH3(Ammonia) -  Non-Standard SubCooling e DeSuperheating -Ok
                                        If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then


