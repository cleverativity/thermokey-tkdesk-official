                        NameOfTheCondenserForAccessories = NameOfTheCondenserForAccessories & "[I6]"

                        AccessoriesCosts = AccessoriesCosts + accessories.Find(Function(x) x.CondenserId = conderserId).SixPoleRepairSwitchI

