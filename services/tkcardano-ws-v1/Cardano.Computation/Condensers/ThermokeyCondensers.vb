                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)

