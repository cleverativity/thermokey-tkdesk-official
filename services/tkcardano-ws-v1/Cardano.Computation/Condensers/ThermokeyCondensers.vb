                                    thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, (this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                    'Non-Standard SubCooling e DeSuperheating  - (<<OLD TRADITIONAL>> REFRIGERANTS)-Ok
                                    If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then

                                        'C. Gnesutta, December 7th, 2020. - EC-Ziehl/Abbeg:(3Ph-400V~50Hz) (<<OLD TRADITIONAL>> Refrigerants)-Ok
                                        thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                        'C. Gnesutta, December 7th, 2020. - EC-Ziehl/Abbeg:(3Ph-400V~50Hz) (<<OLD TRADITIONAL>> Refrigerants)-Ok
                                        thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_EC_FansFlow_3Ph_400V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                    Else
                                    End If


                            End Select


                            'EC-Ziehl/Abbeg:(3Ph-400V~50Hz): Nel caso non sia presente il ventilatore EC i calcoli termodinamici non vengono efettuati,
                            'risparmiando così tempo di computazione. C. Gnesutta, December 7th, 2020
                        Else

                            thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = 0

                        End If


                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                        'HEAT POWER RELEASED BY THE WHOLE REMOTE CONDENSER.

                        'C. Gnesutta, December 7th, 2020.


                        'Here we are going to calcultate the final heat power released by the whole machine.


                        '(Si è volutamente imposto che le correzioni siano uguali nei casi STAR e DELTA)

                        ThermalCapacityCorrections = condensers(idCM - 1).Correction_Delta

                        'OK. Errore corretto da C. Gnesutta il 10 Dicembre 2020. - Ok
                        ' C. Gnesutta, 7 Gennaio 2021
                        thisTk_Condenser_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = (ThermalCapacityCorrections * thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) * condensers(idCM - 1).Number_Coils)

                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                        EC_Index = EC_Index + 1
                    End While


                    'EC-Ziehl-Abegg: Iterazione sulle 6 curve dei ventilatori - EC Ziehl-Abegg (1Ph-230V~50Hz)
                    EC_Index = 0

                    While EC_Index < 6

                        If ((Me.EC_FansFlowRate.EC_New_FanSeriesZiehl(idCM - 1) <> "*******") And Me.EC_FansFlowRate.FanVoltage_EC_ZiehlAbbeg(idCM - 1) = 230) Then

                            Select Case True

                                'EC-Ziehl-Abegg: (1Ph-230V~50Hz) - Curve1  -C. Gnesutta, December 9th, 2020.- (B2)- (<<NEW>> REFRIGERANTS)- Ok
                                Case (EC_Index = 0)
                                    this_EC_FansFlow_1Ph_230V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve1_FlowRate_Ziehl(idCM - 1)

                                    'EC-Ziehl-Abegg: (1Ph-230V~50Hz) - Curve2  -C. Gnesutta, December 9th, 2020.- (B2)- (<<NEW>> REFRIGERANTS)- Ok
