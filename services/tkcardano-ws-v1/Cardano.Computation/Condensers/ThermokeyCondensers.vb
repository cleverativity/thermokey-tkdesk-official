    Public Function SearchToleranceCapacity(unitsType As String, tolerance As Double) As Double

        Select Case unitsType ' Me.thisActiveSheet
            Case "imp", "English" ' Case "Condensers imp"
                Return tolerance
            Case "si", "Metric" ' Case "Condensers si"
                Return tolerance
            Case Else
                Return Nothing
        End Select

    End Function

    Public Function SearchCondenserCapacity(unitsType As String, thermalCapacity As Double) As Double

        Select Case unitsType 'Me.thisActiveSheet
            Case "imp", "English" ' Case "Condensers imp"
                Return ConvertValue.KWFromBtuPerHr * thermalCapacity
            Case "si", "Metric" ' Case "Condensers si"
                Return thermalCapacity

            Case Else
                Return Nothing
        End Select

    End Function


    Public Function DegFfromDegDryBulb(value As Double) As Double
        Return convertValue.DegFfromDegC(value)
    End Function
    Public Function CondensingTemperature(unitsType As String, condensing As Double) As Double

        Select Case unitsType' Me.thisActiveSheet
            Case "imp", "English" ' Case "Condensers imp"

                'Added by C. Gnesutta to calculate new refrigerants. - NUOVI REFRIGERANTI
                'C. Gnesutta, 10 Aprile 2018.
                Return Me.convertValue.DegCfromDegF(Me.convertValue.DegFfromDegC(condensing))

            Case "si", "Metric" 'Case "Condensers si"

                'Added by C. Gnesutta to calculate new refrigerants. - NUOVI REFRIGERANTI
                'C. Gnesutta, 10 Aprile 2018.
                Return Me.convertValue.DegCfromDegF(Me.convertValue.DegFfromDegC(condensing))


            Case Else
                Return Nothing

        End Select

    End Function

    'Dim CondenserDeSuperHeatDegrees As Double = 45 'CondenserDeSuperHeatDegrees = condeserDegress
    Public Function CondenserDeSuperHeatDegrees(unitsType As String, compressor As Double) As Double

        'Set the DeSuperHeating temperature in °R (45 °R = 25 K)
        'Dim deSuperHeatingTemp As Double = 45 'Default value

        'Get
        Select Case unitsType 'Me.thisActiveSheet
            Case "imp", "English" '  Case "Condensers imp"
                Return compressor
            Case "si", "Metric" ' Case "Condensers si"
                Return (9 / 5) * compressor
            Case Else
                Select Case unitsType
                    Case "English"
                        Return 45
                    Case "Metric"
                        Return (9 / 5) * compressor
                    Case Else
                        Return Nothing
                End Select
        End Select
        'End Get
        'Set(ByVal Value As Double)
        '    Me.FpSpread1.Sheets(0).Cells(8, 9).Value = Value
        '    Me.FpSpread1.Sheets(1).Cells(8, 9).Value = (5 / 9) * Value
        'End Set
    End Function

    Public Function CondenserSubCoolDegrees(unitsType As String, subCooling As Double) As Double
        ' Set the SubCooling temperature in °R (5.4 °R = 3 K)
        'Dim subCoolingTemp As Double = 3

        Select Case unitsType 'Me.thisActiveSheet
            Case "imp", "English" ' Case "Condensers imp"
                Return subCooling
            Case "si", "Metric" ' Case "Condensers si"
                Return (9 / 5) * subCooling
            Case Else
                Select Case unitsType
                    Case "English"
                        Return subCooling
                    Case "Metric"
                        Return (9 / 5) * subCooling
                    Case Else
                        Return Nothing
                End Select
        End Select

    End Function





    Private Function CalculatePressureCondenser(ByVal MCHX_CoilAltitude As Double) As Double

        Dim TK_StandardAtmosphere As New StandardAtmosphere

        Dim _thisAtmosphericPressure As Double = 0

        TK_StandardAtmosphere.altitudeIN = (ConvertValue.FeetFromMeter * MCHX_CoilAltitude)

        _thisAtmosphericPressure = ConvertValue.kilopascalFromPsia * TK_StandardAtmosphere.calcAltitudePSIA

        Return _thisAtmosphericPressure

    End Function

