                                'Accessory name to be written on the final pdf.  C. Gnesutta, 17 Aprile 2019. - OK
                                NameOfTheCondenserForAccessories = NameOfTheCondenserForAccessories & "W[I3]"

                                AccessoriesCosts = AccessoriesCosts + accessories.Find(Function(x) x.CondenserId = conderserId).ThreePoleRepairSwitchI + accessories.Find(Function(x) x.CondenserId = conderserId).WiringE

                                detail.AccessoriesItems.Add(New AccessoriesItemList With {
