                                'OLD Standard  refrigerants - AC-1Phase -230V~50Hz - MonoPhase -  C. Gnesutta, December 4th, 2020.- OK
                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

