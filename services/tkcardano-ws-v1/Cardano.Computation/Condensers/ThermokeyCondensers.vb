                For Each idCM In thisIdModel

                    'EC- EBM-Papst - 3Ph-400V~50Hz- C. Gnesutta, December 4th, 2020- OK

                    EC_Index = 0

                    'Iterazione sulle 6 curve dei ventilatori - 3Phases- 400V~50Hz - OK
                    'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                    While EC_Index < 6

                        If (Me.EC_FansFlowRate.EC_New_FanSeriesEbmPapst(idCM - 1) <> "*******" And Me.EC_FansFlowRate.Nom_Value_EBM_Papst_EC_Voltage(idCM - 1) = 400) Then

                            'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
