                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                        'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro25
                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                        ' Al momento non esistono ventilatori EC su Condensatori Remoto TkSmart

                                        'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                                    Else

                                        'C. Gnesutta, December 4th, 2020 - EC:Ziehl Abegg : 1Phase/230V~50Hz (TkMicro32/NH3)-Ok
                                        thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                        'TkMicro32/NH3 - Non-Standard DeSuperHeating and Non-Standard SubCooling-Ok

                                        If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then


                                            'C. Gnesutta, December 4th, 2020 - EC:Ziehl Abegg : 1Phase/230V~50Hz (TkMicro32/NH3)-Ok
                                            thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                            'C. Gnesutta, December 4th, 2020 - EC:Ziehl Abegg : 1Phase/230V~50Hz (TkMicro32/NH3)-Ok
                                            thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


                                        Else

                                        End If


                                    End If

                                    'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                                Case Else

                                    'C. Gnesutta, December 4th, 2020 - EC-Ziehl Abegg: 1Ph-230V~50Hz - (<<OLD TRADITIONAL>> REFRIGERANTS)-Ok
                                    thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                    'Non-Standard SubCooling e DeSuperheating  -  (<<OLD TRADITIONAL>> REFRIGERANTS)-Ok
                                    If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then


                                        'C. Gnesutta, December 4th, 2020 - EC-Ziehl Abegg: 1Ph-230V~50Hz- (<<OLD TRADITIONAL>> REFRIGERANTS)-Ok
                                        thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                        'C. Gnesutta, December 4th, 2020 - EC-Ziehl Abegg: 1Ph-230V~50Hz - (<<OLD TRADITIONAL>> REFRIGERANTS)-Ok
                                        thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_Ziehl_Abegg / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)



                                    Else
                                    End If

                            End Select

                            'EC-EBM Papst - 230V/1Phase~50 Hz: Nel caso non sia presente il ventilatore EC i calcoli termodinamici non vengono efettuati,
                            'risparmiando così tempo di computazione. C. Gnesutta, December 7th, 2020
                        Else

                            thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = 0

                        End If


                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                        'Here we are going to calcultate the final heat power released by the whole machine.
                        'OK- C. Gnesutta, December 4th, 2020. - OK

                        ' si è volutamente imposto che le correzioni siano uguali nei casi STAR e DELTA - OK
                        ThermalCapacityCorrections = condensers(idCM - 1).Correction_Delta


                        'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                        thisTk_Condenser_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) = ThermalCapacityCorrections * thisCoilCapacity_EC_1Ph_Ziehl_Abegg_230V(idCM - 1, EC_Index) * condensers(idCM - 1).Number_Coils
                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                        EC_Index = EC_Index + 1
                    End While

                Next idCM


                '************************************************************************************************************************
                '************************************************************************************************************************
                '************************************************************************************************************************
                '4. Fourth Case (AC-1Ph-230V~50Hz) - AC Fans - MonoPhase
                '************************************************************************************************************************
                '************************************************************************************************************************
                '************************************************************************************************************************

                'AC- MONOPHASE 230 V - C. Gnesutta, December 7th, 2020.
                'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021

                'In Supremae Dignitatis
            Case (search.FansConnection = "AC-1Ph-230V~50Hz")


                For Each idCM In thisIdModel

                    '>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
                    'AIR FLOW RATE - Case <<AC-1Ph-230V~50Hz>> (AC Fans)
                    '>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

                    '*******************************************************************
                    '*******************************************************************
                    'AC - CASE: Definition of the volumetric Air Flow Rate for each MCHX Remote Condenser (only AC case)
                    'C. Gnesutta, December 2nd, 2020.

                    this_AC_FansFlow_1Phase = condensers(idCM - 1).Delta_Fans_Flow

                    '*******************************************************************
                    '*******************************************************************


                    'OK - Checked by C. Gnesutta on November 20th, 2020.
                    Select Case True

                        'Nuovi refrigeranti - C. Gnesutta, 19 Luglio 2019.
                        'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                        Case ((sigma = "R-32") Or (sigma = "R-245fa") Or (sigma = "R-407F") Or (sigma = "R-449a") Or (sigma = "R-513a") Or (sigma = "R-600") Or (sigma = "R-600a") Or (sigma = "R-1234yf") Or (sigma = "R-1234ze"))


                            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                            'Refrigerant  correction factors (C3) according to RS 7/C/008 - 2018, Published on June 2018

                            'OK -  C. Gnesutta, December 7th 2020.

                            Me.TubeWidthCalculation(idCM)

                            thisC3 = ThermokeyCondenserCapacities.ChangeRefrgerantTypeAdjustment(sigma)
                            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                            'New refrigerants - 1Phase - AC-230V~50Hz  - MONOPHASE -   C. Gnesutta, December 7th, 2020.-Ok

                            thisCoilCapacity_AC_1Ph_230V(idCM - 1) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", (this_AC_FansFlow_1Phase / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                            'Non-Standard SubCooling e DeSuperheating  - (NEW REFRIGERANTS)-Ok
                            'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                            If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then

                                'New refrigerants - 1Phase - AC-230V~50Hz  - MONOPHASE -   C. Gnesutta, December 7th, 2020.-Ok
                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                'New refrigerants - 1Phase - AC-230V~50Hz  - MONOPHASE -   C. Gnesutta, December 7th, 2020.-Ok
                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                            Else
                            End If


                            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                            'OK - Checked by C. Gnesutta on December 7h, 2020.-Ok
                            thisCoilCapacity_AC_1Ph_230V(idCM - 1) = (thisCoilCapacity_AC_1Ph_230V(idCM - 1) * thisC3)

                            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                            'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                        Case (sigma = "R717-(NH3)")


                            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                            'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro25 - MonoPhase- 1Phase/230Volt - AC
                            '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                            If (condensers(idCM - 1).Series = "MC") Then


                                'TkMicro25/NH3(Ammonia) -  AC-1Phase -230V~50Hz  -MonoPhase -  C. Gnesutta,  December 7th, 2020.-Ok
                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = TkMicro25_NH3.CoilCapacity_NH3_TkMicro25(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)

                                'TkMicro25/NH3(Ammonia) -  Non-Standard SubCooling e DeSuperheating -Ok
                                If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then


                                    'TkMicro25/NH3(Ammonia) -  AC-1Phase -230V~50Hz  -MonoPhase -  C. Gnesutta,  December 7th, 2020.-Ok
                                    thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro25_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                    'TkMicro25/NH3(Ammonia) -  AC-1Phase -230V~50Hz  -MonoPhase -  C. Gnesutta,  December 7th, 2020.-Ok
                                    thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro25_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                Else
                                End If


                                '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro32 - MonoPhase- 1Phase/230Volt - AC
                                '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                            Else


                                'TkMicro32/NH3(Ammonia) -  AC-1Phase -230V~50Hz  - MonoPhase -  C. Gnesutta,  December 7th, 2020.-Ok
                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                'TkMicro32/NH3(Ammonia) -  Non-Standard SubCooling e DeSuperheating -Ok
                                If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then

                                    'TkMicro32/NH3(Ammonia) -  AC-1Phase -230V~50Hz  -MonoPhase -  C. Gnesutta,  December 7th, 2020.-Ok
                                    thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                    'TkMicro32/NH3(Ammonia) -  AC-1Phase -230V~50Hz  -MonoPhase -  C. Gnesutta,  December 7th, 2020.-Ok
                                    thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                Else
                                End If

                            End If

                        Case Else


                            'OLD Standard  refrigerants - AC-1Phase -230V~50Hz - MonoPhase -  C. Gnesutta, December 7th, 2020.-Ok
                            'OK - Controllato da C. Gnesutta il 30 Marzo 2021.

                            thisCoilCapacity_AC_1Ph_230V(idCM - 1) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, (this_AC_FansFlow_1Phase / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)



                            'Non-Standard SubCooling e DeSuperheating  - (<<OLD STANDARD>> REFRIGERANTS)-Ok
                            If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then

                                'OLD Standard  refrigerants - AC-1Phase -230V~50Hz - MonoPhase -  C. Gnesutta, December 7th, 2020.-Ok

                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                'OLD Standard  refrigerants - AC-1Phase -230V~50Hz - MonoPhase -  C. Gnesutta, December 7th, 2020.-Ok

                                thisCoilCapacity_AC_1Ph_230V(idCM - 1) = thisCoilCapacity_AC_1Ph_230V(idCM - 1) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_AC_FansFlow_1Phase / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


                            Else
                            End If

                    End Select


                    ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                    'HEAT POWER RELEASED BY THE WHOLE REMOTE CONDENSER.

                    'Here we are going to calcultate the final heat power released by the whole machine.

                    'C. Gnesutta, December 9th, 2020.

                    'Si è volutamente imposto che le correzioni siano uguali nei casi STAR e DELTA -Ok

                    ThermalCapacityCorrections = condensers(idCM - 1).Correction_Delta


                    'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                    thisTk_Condenser_AC_1Ph_230V(idCM - 1) = (ThermalCapacityCorrections * thisCoilCapacity_AC_1Ph_230V(idCM - 1) * condensers(idCM - 1).Number_Coils)



                    ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                Next idCM


                '************************************************************************************************************************
                '************************************************************************************************************************
                '************************************************************************************************************************
                '5. Fifth Case (EC-3Ph-400V-(B2)~50Hz) - EC Fans
                '************************************************************************************************************************
                '************************************************************************************************************************
                '************************************************************************************************************************

                ' In Supremae Dignitatis  C. Gnesutta, 7 Gennaio 2021
                'In Supremae Dignitatis
                'OK - Controllato da C. Gnesutta il 30 Marzo 2021.
            Case (search.FansConnection = "EC-3Ph-400V-(B2)~50Hz")

                For Each idCM In thisIdModel

                    EC_Index = 0

                    'Iterazione sulle 6 curve dei ventilatori - EC-Ziehl Abbeg  (3Ph-400V~50Hz)

                    ' C. Gnesutta, 7 Gennaio 2021
                    While EC_Index < 6

                        'EC-Ziehl Abbeg: Solo nel caso in cui sia presente il ventilatore EC, i calcoli termodinamici  vengono effettuati,
                        'risparmiando così tempo di computazione. C. Gnesutta, November 23rd, 2020
                        If (Me.EC_FansFlowRate.EC_New_FanSeriesZiehl(idCM - 1) <> "*******" And Me.EC_FansFlowRate.Nom_Value_Ziehl_EC_Voltage(idCM - 1) = 400) Then

                            Select Case True

                                'EC-Ziehl Abegg: (3Ph-400V~50Hz) - Curve1-C. Gnesutta, December 7th, 2020.-Ok
                                Case (EC_Index = 0)

                                    this_EC_FansFlow_3Ph_400V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve1_FlowRate_Ziehl(idCM - 1)

                                    'EC-Ziehl Abegg: (3Ph-400V~50Hz) - Curve2-C. Gnesutta, December 7th, 2020.-Ok
                                Case (EC_Index = 1)

                                    this_EC_FansFlow_3Ph_400V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve2_FlowRate_Ziehl(idCM - 1)

                                    'EC-Ziehl Abegg: (3Ph-400V~50Hz) - Curve3-C. Gnesutta, December 7th, 2020.-Ok
                                Case (EC_Index = 2)

                                    this_EC_FansFlow_3Ph_400V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve3_FlowRate_Ziehl(idCM - 1)

                                    'EC-Ziehl Abegg: (3Ph-400V~50Hz) - Curve4-C. Gnesutta, December 7th, 2020.-Ok
                                Case (EC_Index = 3)

                                    this_EC_FansFlow_3Ph_400V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve4_FlowRate_Ziehl(idCM - 1)


                                    'EC-Ziehl Abegg: (3Ph-400V~50Hz) - Curve5-C. Gnesutta, December 7th, 2020.-Ok
