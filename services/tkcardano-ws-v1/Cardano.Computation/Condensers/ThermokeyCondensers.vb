                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                    'TkMicro25/NH3(Ammonia) - 3Ph-400V-(DELTA)~50H) -  C. Gnesutta, December 9th, 2020.- Ok
                                    thisCoilCapacity_AC_3Ph_Star(idCM - 1) = TkMicro25_NH3.CoilCapacity_NH3_TkMicro25(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                    'TkMicro25/NH3(Ammonia) -  Non-Standard SubCooling e DeSuperheating - Ok
                                    If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then

                                        'TkMicro25/NH3(Ammonia) - 3Ph-400V-(DELTA)~50H) -  C. Gnesutta, December 9th, 2020.- Ok
                                        thisCoilCapacity_AC_3Ph_Star(idCM - 1) = thisCoilCapacity_AC_3Ph_Star(idCM - 1) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro25_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                        'TkMicro25/NH3(Ammonia) - 3Ph-400V-(DELTA)~50H) -  C. Gnesutta, December 9th, 2020.- Ok
                                        thisCoilCapacity_AC_3Ph_Star(idCM - 1) = thisCoilCapacity_AC_3Ph_Star(idCM - 1) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro25_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


                                    Else
                                    End If


                                    ' C. Gnesutta, 7 Gennaio 2021
                                Else

                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                    'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro32 -3Ph-400V-(STAR)~50H
                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                    'TkMicro32/NH3(Ammonia) - 3Ph-400V-(DELTA)~50H) -  C. Gnesutta, December 9th, 2020.- Ok
                                    thisCoilCapacity_AC_3Ph_Star(idCM - 1) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                    'TkMicro32/NH3(Ammonia) -  Non-Standard SubCooling e DeSuperheating
                                    If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then

                                        'TkMicro32/NH3(Ammonia) - 3Ph-400V-(DELTA)~50H) -  C. Gnesutta, December 9th, 2020.- Ok
                                        thisCoilCapacity_AC_3Ph_Star(idCM - 1) = thisCoilCapacity_AC_3Ph_Star(idCM - 1) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                        'TkMicro32/NH3(Ammonia) - 3Ph-400V-(DELTA)~50H) -  C. Gnesutta, December 9th, 2020.- Ok
                                        thisCoilCapacity_AC_3Ph_Star(idCM - 1) = thisCoilCapacity_AC_3Ph_Star(idCM - 1) + SecondThermodynamicEngine_NH3.CapacitySubCooling_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)


                                    Else
                                    End If


                                End If


                                ' C. Gnesutta, 7 Gennaio 2021
                            Case Else

                                'C. Gnesutta, December 9th, 2020-AC-3Ph-400V-(STAR)~50Hz-(<<OLD>> STANDARD REFRIGERANTS)- Ok
                                'OK - Controllato da C. Gnesutta il 30 Marzo 2021.
                                thisCoilCapacity_AC_3Ph_Star(idCM - 1) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, (this_AC_FansFlow_Star / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                'Non-Standard SubCooling e DeSuperheating  - (<<OLD TRADITIONAL>> REFRIGERANTS)- Ok
                                If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then


                                    'C. Gnesutta, December 9th, 2020-AC-3Ph-400V-(STAR)~50Hz-(<<OLD>> STANDARD REFRIGERANTS)- Ok
                                    thisCoilCapacity_AC_3Ph_Star(idCM - 1) = thisCoilCapacity_AC_3Ph_Star(idCM - 1) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                    'C. Gnesutta, December 9th, 2020-AC-3Ph-400V-(STAR)~50Hz-(<<OLD>> STANDARD REFRIGERANTS)- Ok
                                    thisCoilCapacity_AC_3Ph_Star(idCM - 1) = thisCoilCapacity_AC_3Ph_Star(idCM - 1) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_AC_FansFlow_Star / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                Else
                                End If

                        End Select


                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                        'HEAT POWER RELEASED BY THE WHOLE REMOTE CONDENSER.

                        'C. Gnesutta, December 9th, 2020.

                        'Here we are going to calcultate the final heat power released by the whole machine.

                        'Si è volutamente imposto che le correzioni siano uguali nei casi STAR e DELTA - Ok

                        ThermalCapacityCorrections = condensers(idCM - 1).Correction_Delta

                        'C. Gnesutta, December 9th, 2020. - Ok
                        ' C. Gnesutta, 7 Gennaio 2021
                        thisTk_Condenser_AC_3Ph_Star(idCM - 1) = (ThermalCapacityCorrections * thisCoilCapacity_AC_3Ph_Star(idCM - 1) * condensers(idCM - 1).Number_Coils)

                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                    Else

                        thisTk_Condenser_AC_3Ph_Star(idCM - 1) = 0

                    End If


                Next idCM


                '************************************************************************************************************************
                '************************************************************************************************************************
                '9. Nineth Case (EC-1Ph-230V-(MonoPhase)~50Hz) - EC Fans
                '************************************************************************************************************************
                '************************************************************************************************************************

                'EBM-Papst (EC-1Ph-230V-(MonoPhase)~50Hz)
                ' C. Gnesutta, 7 Gennaio 2021
                'In Supremae Dignitatis


                '************************************************************************************************************************
                '************************************************************************************************************************
                '9. Nineth Case (EC-1Ph-230V-(MonoPhase)~50Hz) - EC Fans
                '************************************************************************************************************************
                '************************************************************************************************************************

                'EBM-Papst (EC-1Ph-230V-(MonoPhase)~50Hz)
                ' C. Gnesutta, 7 Gennaio 2021
                'In Supremae Dignitatis
            Case (search.FansConnection = "EC-1Ph-230V~50Hz")

                For Each idCM In thisIdModel

                    EC_Index = 0

                    'Iterazione sulle 6 curve dei ventilatori - 1Ph-230V~50Hz  -EBM _Papst
                    While EC_Index < 6


                        If ((Me.EC_FansFlowRate.EC_New_FanSeriesEbmPapst(idCM - 1) <> "*******") And Me.EC_FansFlowRate.Nom_Value_EBM_Papst_EC_Voltage(idCM - 1) = 230) Then

                            Select Case True


                                'EC-EBM _Papst: (1Ph-230V~50Hz) - Curve1 - C. Gnesutta, December 9th, 2020.- Ok

                                Case (EC_Index = 0)

                                    this_EC_FansFlow_1Ph_230V_EBM_Papst = EC_FansFlowRate.EC_Curve1_FlowRate_EBMPapst(idCM - 1)


                                    'EC-EBM _Papst: (1Ph-230V~50Hz) - Curve2-C. Gnesutta, December 9th, 2020.- Ok
                                Case (EC_Index = 1)

                                    this_EC_FansFlow_1Ph_230V_EBM_Papst = EC_FansFlowRate.EC_Curve2_FlowRate_EBMPapst(idCM - 1)


                                    'EC-EBM _Papst: (1Ph-230V~50Hz) - Curve3-C. Gnesutta, December 9th, 2020.- Ok
                                Case (EC_Index = 2)
                                    this_EC_FansFlow_1Ph_230V_EBM_Papst = EC_FansFlowRate.EC_Curve3_FlowRate_EBMPapst(idCM - 1)


                                    'EC-EBM _Papst: (1Ph-230V~50Hz) - Curve4-C. Gnesutta, December 9th, 2020.- Ok
                                Case (EC_Index = 3)

                                    this_EC_FansFlow_1Ph_230V_EBM_Papst = EC_FansFlowRate.EC_Curve4_FlowRate_EBMPapst(idCM - 1)


                                    'EC-EBM _Papst: (1Ph-230V~50Hz) - Curve5-C. Gnesutta, December 9th, 2020.- Ok
                                Case (EC_Index = 4)

                                    this_EC_FansFlow_1Ph_230V_EBM_Papst = EC_FansFlowRate.EC_Curve5_FlowRate_EBMPapst(idCM - 1)


                                    'EC-EBM _Papst: (1Ph-230V~50Hz) - Curve6-C. Gnesutta, December 9th, 2020.- Ok
                                Case (EC_Index = 5)

                                    this_EC_FansFlow_1Ph_230V_EBM_Papst = EC_FansFlowRate.EC_Curve6_FlowRate_EBMPapst(idCM - 1)


                                Case Else
                            End Select


                            Select Case True

                                ' C. Gnesutta, 7 Gennaio 2021
                                Case ((sigma = "R-32") Or (sigma = "R-245fa") Or (sigma = "R-407F") Or (sigma = "R-449a") Or (sigma = "R-513a") Or (sigma = "R-600") Or (sigma = "R-600a") Or (sigma = "R-1234yf") Or (sigma = "R-1234ze"))


                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                    'Refrigerant  correction factors (C3) according to RS 7/C/008 - 2018, Published on June 2018
                                    ' C. Gnesutta, December 9th, 2020.

                                    Me.TubeWidthCalculation(idCM)
                                    thisC3 = ThermokeyCondenserCapacities.ChangeRefrgerantTypeAdjustment(sigma)
                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                    'C. Gnesutta, December 9th, 2020-EC-EBM _Papst: (1Ph-230V~50Hz)- (<<NEW>> REFRIGERANTS)- Ok
                                    'OK - Controllato da C. Gnesutta il 30 Marzo 2021.

                                    thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", (this_EC_FansFlow_1Ph_230V_EBM_Papst / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                    'Non-Standard SubCooling e DeSuperheating  - (<<NEW>> REFRIGERANTS)
                                    If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then

                                        'C. Gnesutta, December 9th, 2020-EC-EBM _Papst: (1Ph-230V~50Hz)- (<<NEW>> REFRIGERANTS)- Ok
                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                        'C. Gnesutta, December 9th, 2020-EC-EBM _Papst: (1Ph-230V~50Hz)- (<<NEW>> REFRIGERANTS)- Ok
                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                    Else

                                    End If


                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                    'OK - Checked by C. Gnesutta on December 9th, 2020.- Ok
                                    ' C. Gnesutta, 7 Gennaio 2021
                                    thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) * thisC3

                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                Case (sigma = "R717-(NH3)")


                                    'OK- Checked by C. Gnesutta on July 31st, 2019.- TkMicro25/NH3
                                    If (condensers(idCM - 1).Series = "MC") Then


                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                        'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro25 -3Ph-400V-(1Phase - EBM/Papst)~50H
                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                        'No TkMicro25 machines with EC fans


                                    Else

                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                        'AMMONIACA (NH3) - GEOMETRIA MICROCANALE TkMicro32 -3Ph-400V-(1Phase - EBM/Papst)~50H
                                        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                        'TkMicro32/NH3(Ammonia) - EC-EBM _Papst: (1Ph-230V~50Hz) -  C. Gnesutta, December 9th, 2020.- Ok
                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = TkMicro32_NH3.CoilCapacity_NH3_TkMicro32(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)



                                        'TkMicro32/NH3(Ammonia) -  Non-Standard SubCooling e DeSuperheating
                                        If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat_NH3 Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling_NH3) Then

                                            'TkMicro32/NH3(Ammonia) - EC-EBM _Papst: (1Ph-230V~50Hz) -  C. Gnesutta, December 9th, 2020.- Ok
                                            thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                            'TkMicro32/NH3(Ammonia) - EC-EBM _Papst: (1Ph-230V~50Hz) -  C. Gnesutta, December 9th, 2020.- Ok
                                            thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + SecondThermodynamicEngine_NH3.CapacityDeSuperheating_TkMicro32_NH3(condensers(idCM - 1).Coil_Type_NH3, condensers(idCM - 1).Coil_Length, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, (5 / 9) * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)


                                        Else

                                        End If


                                    End If

                                    ' C. Gnesutta, 7 Gennaio 2021

                                    'OK - Controllato da C. Gnesutta il 30 Marzo 2021.
                                Case Else


                                    'C. Gnesutta, December 9th, 2020-EC-EBM _Papst: (1Ph-230V~50Hz)- (<<OLD>> STANDARD REFRIGERANTS)- Ok
                                    thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = ThermokeyCondenserCapacities.CoilStandardCapacity(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, (this_EC_FansFlow_1Ph_230V_EBM_Papst / 60) / condensers(idCM - 1).Number_Coils, (5 / 9) * (CondensingTemperature(unitType, search.Condensing) - search.DryBulb), search.AtmPressureInMetric)


                                    'Non-Standard SubCooling e DeSuperheating  - (<<OLD TRADITIONAL>> REFRIGERANTS)
                                    If (CondenserDeSuperHeatDegrees(unitType, search.Compressor) <> DefaultDesuperheat Or CondenserSubCoolDegrees(unitType, search.SubCooling) <> DefaultSubcooling) Then

                                        'C. Gnesutta, December 9th, 2020-EC-EBM _Papst: (1Ph-230V~50Hz)- (<<OLD>> STANDARD REFRIGERANTS)- Ok
                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                        'C. Gnesutta, December 9th, 2020-EC-EBM-Papst: (EC/1Ph-230V~50Hz)- (<<OLD>> STANDARD REFRIGERANTS)- Ok
                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, search.RefrigerantType, this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                    Else


                                    End If

                            End Select

                        Else


                            thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = 0

                        End If


                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                        'HEAT POWER RELEASED BY THE WHOLE REMOTE CONDENSER.

                        'Here we are going to calcultate the final heat power released by the whole machine.

                        'Si è volutamente imposto che le correzioni siano uguali nei casi STAR e DELTA
                        'C. Gnesutta, December 9th, 2020. - Ok

                        ThermalCapacityCorrections = condensers(idCM - 1).Correction_Delta


                        ' C. Gnesutta, 7 Gennaio 2021
                        thisTk_Condenser_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = (ThermalCapacityCorrections * thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) * condensers(idCM - 1).Number_Coils)

                        ' €€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                        EC_Index = EC_Index + 1


                    End While


                    EC_Index = 0

                    'Ziehl-Abegg - EC-1Ph-230V-(MonoPhase)~50Hz (B2)
                    'Iterazione sulle 6 curve dei ventilatori - 1Ph-230V~50Hz - Ziehl-Abegg
                    While EC_Index < 6

                        If ((Me.EC_FansFlowRate.EC_New_FanSeriesZiehl(idCM - 1) <> "*******") And Me.EC_FansFlowRate.FanVoltage_EC_ZiehlAbbeg(idCM - 1) = 230) Then

                            Select Case True


                                'C. Gnesutta, December 9th, 2020 - Ziehl-Abegg - Curve1: (1Ph-230V~50Hz)(B2)- Ok
                                Case (EC_Index = 0)
                                    this_EC_FansFlow_1Ph_230V_Ziehl_Abegg = EC_FansFlowRate.EC_Curve1_FlowRate_Ziehl(idCM - 1)


