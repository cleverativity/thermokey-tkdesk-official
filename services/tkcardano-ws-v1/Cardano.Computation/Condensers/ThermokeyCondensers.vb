                                FanNoiseMachine.FanNumberPerEachRow = condensers(EC_1Ph_B2_FoundId - 1).Num_Of_Fan_Per_Row

                                'Pending
                                'Me.FpSpread1.Sheets(0).Cells(19 + thisColumnFinalRowCount, 3).Value = FanNoiseMachine.MachineFanNoise
                                'Me.FpSpread1.Sheets(1).Cells(19 + thisColumnFinalRowCount, 3).Value = FanNoiseMachine.MachineFanNoise

                                Dim name = condensers(EC_1Ph_B2_FoundId - 1).Model & CondensatoreScelto
                                Dim Capacity As Object
                                Dim Internal_volume As Object


                                If unitsType = "si" Then
                                    Capacity = EC_1Phase_B1_foundCapacity
                                    Internal_volume = Math.Round(condensers(EC_1Ph_B2_FoundId - 1).Tube_Volume, 2)

                                Else
                                    Capacity = ConvertValue.BtuPerHrFromKW * EC_1Phase_B1_foundCapacity
                                    Internal_volume = Math.Round(61.023744 * condensers(EC_1Ph_B2_FoundId - 1).Tube_Volume, 3)
                                End If


                                detailsList.Add(New ComputationResults() With {
                            .Id = tempId,
