                                        thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_1Ph_230V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

                                    Else
                                    End If


                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                    'New refrigerants - 1Phase -230V/50Hz - EC-EBM Papst - C. Gnesutta, December 3rd, 2020.- OK
                                    'OK- Controllo Finale - C. Gnesutta, 7 Gennaio 2021
                                    thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) = thisCoilCapacity_EC_1Ph_EBM_Papst_230V(idCM - 1, EC_Index) * thisC3

                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
                                    'AMMONIACA (NH3) - GEOMETRIA MICROCANALE-  EC/EBM Papst
                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€


                                    ' Ammonia - C. Gnesutta, December 3rd, 2020 - EC/EBM Papst
                                Case (sigma = "R717-(NH3)")


                                    'EC-EBM Papst  - C. Gnesutta,  December 3rd, 2020.- OK
                                    If (condensers(idCM - 1).Series = "MC") Then


                                        ' Non ci sono macchine EC TkMicro25


