                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve3_DpAir_EBMPapst(found_EC_IdCM - 1)

                Case (found_EC_Index = 3)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve4_DpAir_EBMPapst(found_EC_IdCM - 1)
                Case (found_EC_Index = 4)
                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve5_DpAir_EBMPapst(found_EC_IdCM - 1)

                Case (found_EC_Index = 5)
                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve6_DpAir_EBMPapst(found_EC_IdCM - 1)

                Case Else
            End Select


            'EC Fans - Ziehl-Abegg
        Else


            Select Case True

                Case (found_EC_Index = 0)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve1_DpAir_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 1)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve2_DpAir_Ziehl(found_EC_IdCM - 1)


                Case (found_EC_Index = 2)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve3_DpAir_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 3)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve4_DpAir_Ziehl(found_EC_IdCM - 1)
                Case (found_EC_Index = 4)
                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve5_DpAir_Ziehl(found_EC_IdCM - 1)

                Case (found_EC_Index = 5)
                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve6_DpAir_Ziehl(found_EC_IdCM - 1)
                Case Else
            End Select

        End If

        'Viene tolta la correzione sperimentale alle perdite di carico lato aria, in modo tale da riportare il confronto alle condizioni decise da Norm Costello
        'C. Gnesutta, 17 Dicembre 2020
        this_NewEC_DpAir = this_NewEC_DpAir / 1.45


        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
        'Vengono accettate Perdite di Pressione Lato Aria non superiori a 150 Pa e non inferiori a 10 Pa
        'C. Gnesutta, 17 Dicembre 2020

        If (this_NewEC_DpAir >= this_Max_NewEC_DpAir Or this_NewEC_DpAir <= this_Min_NewEC_DpAir) Then
            thisAirPressureDropCheck = True
        Else
            thisAirPressureDropCheck = False
        End If
        '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

        'Baco Corretto da C. Gnesutta il 27 Gennaio 2021.
        Return thisAirPressureDropCheck
    End Function

