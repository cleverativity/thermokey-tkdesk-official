                    this_NewEC_FansFlow = Me.EC_FansFlowRate.EC_Curve3_FlowRate_Ziehl(found_EC_IdCM - 1)

                    this_NewEC_DpAir = Me.EC_FansFlowRate.EC_Curve3_DpAir_Ziehl(found_EC_IdCM - 1)
