    'flowDirection  Vertical or Horizontal
    'unitsType: "imp", "English" | "si", "Metric"
    Public Function AirFlowDirection(unitsType As String, flowDirection As String) As String

        Select Case unitsType
            Case "imp", "English"
                ' Modificato nuovamente da Cristiano Gnesutta il 12 Gennaio 2015
                Select Case flowDirection 'Me.FpSpread1.Sheets(0).Cells(8, 0).Value
                    Case "Vertical", "Verticale", "Vertikal", "竖直", "вертикальное", "عمودي", "Pionowy", "Dọc", "लंबरूप", "แนวดิ่ง", "Verticální tok"
                        Return "Vertical"
                            ' Modificato nuovamente da Cristiano Gnesutta il 12 Gennaio 2015
                    Case "Horizontal", "Orizzontale", "水平", "горизонтальное", "أفقي", "Poziomy", "Ngang", "क्षैतिज", "แนวระนาบ", "Horizontální tok"
                        Return "Horizontal"
                    Case Else
                        Return Nothing
                End Select
            Case "si", "Metric"
                Select Case flowDirection 'Me.FpSpread1.Sheets(0).Cells(8, 0).Value

                        ' Modificato nuovamente da Cristiano Gnesutta il 12 Gennaio 2015
                    Case "Vertical", "Verticale", "Vertikal", "竖直", "вертикальное", "عمودي", "Pionowy", "Dọc", "लंबरूप", "แนวดิ่ง", "Verticální tok"
                        Return "Vertical"

                            ' Modificato nuovamente da Cristiano Gnesutta il 12 Gennaio 2015
                    Case "Horizontal", "Orizzontale", "水平", "горизонтальное", "أفقي", "Poziomy", "Ngang", "क्षैतिज", "แนวระนาบ", "Horizontální tok"
                        Return "Horizontal"
                    Case Else
                        Return Nothing
                End Select
            Case Else
                Return Nothing
        End Select

    End Function

    Private Sub TubeWidthCalculation(ByVal IdCondenserModelNumber As Int16)

        Dim i As Int16 = IdCondenserModelNumber - 1

        If (condensers(i).Series = "MC") Then

            _microchannelTubeWidth = "25"

        Else
            _microchannelTubeWidth = "32"

        End If


    End Sub
