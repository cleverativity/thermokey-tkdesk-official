    Public Function AccessoriesItemList(condensers As List(Of Condenser), accItems As List(Of AccessoriesItems), conderserId As Int32, condenserModel As String) As List(Of AccessoriesItems)


        Dim detailsList As New List(Of AccessoriesItems)
        Dim MonoPhaseElectricalConnection As Boolean = False

        Try


            Dim suffix As String = Microsoft.VisualBasic.Right(condenserModel, 2)

            Select Case suffix
                Case "DV", "DH"

                    MonoPhaseElectricalConnection = False

                Case "YV", "YH"

                    MonoPhaseElectricalConnection = False

                Case "MV", "MH"

                    MonoPhaseElectricalConnection = True

                Case Else

                    MonoPhaseElectricalConnection = False
            End Select

            Dim NumberOfRowsOfFansForAccessories = condensers(conderserId).Num_Of_Fan_Rows



            If (Microsoft.VisualBasic.Right(condenserModel, 3) = "-B1" Or Microsoft.VisualBasic.Right(condenserModel, 3) = "-B2") Then

                For Each item In accItems
                    If (item.Id >= 12 AndAlso item.Id <= 16) OrElse (item.Id >= 17 AndAlso item.Id <= 19) Then
                        If item.Id Then
                            item.IsDisabled = False
                        End If

                        If (item.Id = 19) Then
                            item.IsDisabled = True
                        End If
                        detailsList.Add(item)
                    End If

                Next


            Else


                If (Microsoft.VisualBasic.Left(condenserModel, 3) = "TMC") Then

                    For Each item In accItems

                        If (item.Id >= 1 AndAlso item.Id <= 10) OrElse (item.Id >= 17 AndAlso item.Id <= 19) Then

                            If (item.Id >= 3 AndAlso item.Id <= 8) Then
                                item.IsDisabled = True
                            End If

                            If (item.Id = 19) Then
                                item.IsDisabled = True
                            End If

                            detailsList.Add(item)
                        End If


                    Next

                Else


                    For Each item In accItems
                        If (item.Id >= 1 AndAlso item.Id <= 10) OrElse (item.Id >= 17 AndAlso item.Id <= 19) Then

                            If item.Id Then
                                item.IsDisabled = False
                            End If

                            If Not (MonoPhaseElectricalConnection) Then

                                If Microsoft.VisualBasic.Left(condenserModel, 4) <> "TMKQ" Then

                                    If item.Id = 5 OrElse item.Id = 6 Then
                                        item.IsDisabled = True
                                    End If

                                Else

                                    If item.Id = 3 OrElse item.Id = 4 Then
                                        item.IsDisabled = False
                                    End If

                                End If


                                If item.Id = 7 OrElse item.Id = 8 OrElse item.Id = 19 Then
                                    item.IsDisabled = True
                                End If


                            Else

                                If item.Id = 3 Or item.Id = 4 Or item.Id = 5 Or item.Id = 6 Or item.Id = 7 Then
                                    item.IsDisabled = True
                                End If


                                If NumberOfRowsOfFansForAccessories = 2 Then

                                    If item.Id = 8 Then
                                        item.IsDisabled = True
                                    End If

                                Else

                                    If item.Id = 8 Then
                                        item.IsDisabled = False
                                    End If

                                End If


                            End If

                            detailsList.Add(item)
                        End If

                    Next



                End If


            End If

        Catch ex As Exception

        End Try

        Return detailsList


    End Function

