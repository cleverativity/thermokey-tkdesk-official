                                    thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_Ziehl_Abegg(idCM - 1, EC_Index) * thisC3

                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€

                                    '€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€
