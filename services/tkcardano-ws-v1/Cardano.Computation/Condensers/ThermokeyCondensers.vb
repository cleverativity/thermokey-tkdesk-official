        FanNoiseMachine.FanRowsNumber = condensers(foundIdCM - 1).Num_Of_Fan_Rows
        FanNoiseMachine.FanNumberPerEachRow = condensers(foundIdCM - 1).Num_Of_Fan_Per_Row

