    Public Function Computation(newCondeser As List(Of Condenser), acc As List(Of Accessories), search As CondenserSearch, pageNumber As Integer, pageSize As Integer, query As String) As PaginatedCondenserResult

        Try


            CapacitySearch(newCondeser, search, "si")

            Dim result = ReportCapacitySearch(acc, search.FansConnection, search.UnitsType, search.FlowDirection, search.RefrigerantType, search.Distance)

            Dim filteredResults As List(Of ComputationResults) = result

            If Not String.IsNullOrWhiteSpace(query) Then
                Dim searchQuery As String = query.Trim().ToLower()

                filteredResults = result.Where(Function(x) _
                    (x.ModelName IsNot Nothing AndAlso x.ModelName.ToLower().Contains(searchQuery)) OrElse
                    x.Id.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Capacity.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Airflow.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Spl.ToString().ToLower().Contains(searchQuery) OrElse
                    x.No_fans.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Rpm.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Power.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Current_a.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Internal_volume.ToString().ToLower().Contains(searchQuery) OrElse
                    x.Weights.ToString().ToLower().Contains(searchQuery) OrElse
                    (x.Inlet_connection IsNot Nothing AndAlso x.Inlet_connection.ToLower().Contains(searchQuery)) OrElse
                    (x.Outlet_connection IsNot Nothing AndAlso x.Outlet_connection.ToLower().Contains(searchQuery)) OrElse
                    x.Price.ToString().ToLower().Contains(searchQuery)
                ).ToList()
            End If

            Dim totalCount = filteredResults.Count
            Dim totalPages = Math.Ceiling(totalCount / pageSize)
            Dim skipCount = (pageNumber - 1) * pageSize

            Dim pagedResults = filteredResults.Skip(skipCount).Take(pageSize).ToList()

            Return New PaginatedCondenserResult With {
                .Results = pagedResults,
                .CurrentPage = pageNumber,
                .PageSize = pageSize,
                .TotalCount = totalCount,
                .TotalPages = totalPages,
                .HasNextPage = pageNumber < totalPages,
                .HasPreviousPage = pageNumber > 1
            }
        Catch ex As ArgumentException
            ' Handle invalid arguments (e.g., invalid page numbers)
            Return New PaginatedCondenserResult With {
                .Results = New List(Of ComputationResults)(),
                .CurrentPage = 1,
                .PageSize = pageSize,
                .TotalCount = 0,
                .TotalPages = 0,
                .HasNextPage = False,
                .HasPreviousPage = False
            }
        Catch ex As Exception
            Return New PaginatedCondenserResult With {
                .Results = New List(Of ComputationResults)(),
                .CurrentPage = 1,
                .PageSize = pageSize,
                .TotalCount = 0,
                .TotalPages = 0,
                .HasNextPage = False,
                .HasPreviousPage = False
            }
        End Try
    End Function


