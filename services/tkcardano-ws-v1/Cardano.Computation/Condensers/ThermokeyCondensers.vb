                                        thisCoilCapacity_EC_3Ph_EBM_Papst(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_EBM_Papst(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacityDeSuperheating(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_3Ph_400V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserDeSuperHeatDegrees(unitType, search.Compressor), search.AtmPressureInMetric)

                                        'EC EBM Papst: 400V~50Hz - (NEW REFRIGERANTS) - C. Gnesutta, December 4th, 2020.- OK
                                        thisCoilCapacity_EC_3Ph_EBM_Papst(idCM - 1, EC_Index) = thisCoilCapacity_EC_3Ph_EBM_Papst(idCM - 1, EC_Index) + CardanoSecondThermodynamicEngine.CapacitySubCooling(condensers(idCM - 1).Coil_Type, condensers(idCM - 1).Coil_Length, "R-404A", this_EC_FansFlow_3Ph_400V_EBM_Papst / condensers(idCM - 1).Number_Coils, 5 / 9 * CondenserSubCoolDegrees(unitType, search.SubCooling), search.AtmPressureInMetric)

