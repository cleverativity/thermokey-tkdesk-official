    'Correction Coefficients for different refrigerants, according to EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
    ' Implemented by C. Gnesutta on July 19th, 2018.
    Public Function ChangeRefrgerantTypeAdjustment(ByVal RefType As String) As Double

        'Refrigerant - refrigerante - Kältemittel - réfrigérant R22 R134A R404A R407C R410A

        Dim C2 As Double
        Select Case RefType

            Case "R-22"
                C2 = 1

                'Added by C. Gnesutta on July 19th 2018. - From Guenthner Software
            Case "R-32"
                C2 = 1.01


            Case "R-134a"
                C2 = 1

                'Added by C. Gnesutta on July 19th 2018. . - From Guenthner Software
            Case "R-245fa"
                C2 = 0.8169


            Case "R-404A"
                C2 = 1

                ' With glide
            Case "R-407C"
                C2 = 1

                ' With glide -   Added by C. Gnesutta on July 19th 2018. - From  EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
            Case "R-407F"
                C2 = 0.94


            Case "R-410A"
                C2 = 1

                'Added by C. Gnesutta on July 19th 2018. - From  EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
            Case "R-448a"
                C2 = 0.89

                'Added by C. Gnesutta on July 19th 2018.- From  EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
            Case "R-449a"
                C2 = 0.89

                'Added by C. Gnesutta on July 19th 2018.- From  EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
            Case "R-450a"
                C2 = 0.93

                'Added by C. Gnesutta on July 19th 2018.- From  EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
            Case "R-452a"
                C2 = 0.93

                'Added by C. Gnesutta on July 19th 2018. - From  EUROVENT RATING STANDARD, RS 7/C/008 - 2018, Published June 2018
            Case "R-513a"
                C2 = 0.95

                'Added by C. Gnesutta on July 19th 2018.
            Case "R-600"
                C2 = 0.9299

                'Added by C. Gnesutta on July 19th 2018.
            Case "R-600a"
                C2 = 0.9491

                'Added by C. Gnesutta on July 19th 2018.
            Case "R-1234yf"
