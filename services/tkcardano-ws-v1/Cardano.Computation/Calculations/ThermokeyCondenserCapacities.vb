    Public Function DetlaTemperatureCapacityAdjustment(ByVal DeltaTemperatureDegreesK As Double, ByVal RefType As String) As Double
        Dim y As Double
        Dim x As Double = DeltaTemperatureDegreesK


        Select Case RefType

            Case "R-22"

                y = +10.3479835565259 * 1 + -5.01695213851242 * Math.Sqrt(x) + 0.763242215921699 * x + -0.0060749225746076 * x * x

            Case "R-134a"

                y = +9.43764918729253 * 1 + -4.42697914387193 * Math.Sqrt(x) + 0.654824080574863 * x + -0.00495538906212924 * x * x

            Case "R-404A"

                y = +10.2837859098511 * 1 + -4.98445737101962 * Math.Sqrt(x) + 0.758706628183926 * x + -0.00604655907344383 * x * x

            Case "R-407C"

                y = +15.9023229525072 * 1 + -8.55743907096612 * Math.Sqrt(x) + 1.39970513803833 * x + -0.0122544906004028 * x * x

            Case "R-410A"

                y = +10.3636506047192 * 1 + -5.02321428989163 * Math.Sqrt(x) + 0.76391694237922 * x + -0.00608174442217295 * x * x

            Case "R-507A"

                y = +10.1496171106126 * 1 + -4.90004811479378 * Math.Sqrt(x) + 0.743729579888266 * x + -0.00590439215287869 * x * x


        End Select


        Dim C1 As Double = y

        Return C1

    End Function


